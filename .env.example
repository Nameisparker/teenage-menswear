# Supabase project credentials — Dashboard > Project Settings > API
#
# Copy this file to .env.local and fill both values there, then restart
# `npm run dev`. Keep THIS file blank: it is committed, and .env.local is not.
#
# The anon key is a public client key — it ships in the browser bundle, so RLS
# is what protects your data, not secrecy of this value. The service_role key
# bypasses RLS entirely and must never appear in any committed file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
